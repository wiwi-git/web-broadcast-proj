# 운영 서버의 /opt/web-broadcast/.env 에 둔다 (권한 600, git에 올리지 않는다)
# deploy/k3s/secrets.sh가 읽어 K3s Secret(db-credentials, simulcast, toss-keys)을 만든다.

# 서버의 공인 IP. 휴대폰이 WebRTC(8189)로 접속할 주소 (K3s에서는 k8s/overlays/oci/mediamtx-public.yaml에 적는다)
PUBLIC_IP=

# PostgreSQL 비밀번호 (openssl rand -hex 24). DB를 처음 만들 때만 적용되므로 나중에 바꾸지 않는다
DB_PASSWORD=

# 유튜브 동시 송출 (ADR-0007). 중계 비밀값은 openssl rand -hex 32, 암호화 키는 openssl rand -base64 32
SIMULCAST_RELAY_SECRET=
SIMULCAST_ENCRYPTION_KEY=

# 토스페이먼츠 API 개별 연동 테스트 키 한 쌍 (test_ck_, test_sk_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
