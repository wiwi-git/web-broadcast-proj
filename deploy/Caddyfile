# duse.dev 메인 페이지
duse.dev {
	root * /var/www/duse.dev
	file_server
	encode gzip
}

# www.duse.dev 는 duse.dev 로 보냄
www.duse.dev {
	redir https://duse.dev{uri} permanent
}

# 방송 프로젝트 (/opt/web-broadcast, docker compose)
live.duse.dev {
	encode gzip

	# MediaMTX만 부르는 서버 내부 API는 밖으로 열지 않는다
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8180
	}

	# 상태 확인: Spring Boot Actuator가 DB 연결까지 보고 {"status":"UP"}을 돌려준다
	handle /actuator/health* {
		reverse_proxy 127.0.0.1:8180
	}

	# 동영상 HLS. Windows 앱(WebView2)은 hls.js로 받아서 앱 origin에서 교차 출처 요청이 된다.
	# 동영상은 누구나 볼 수 있으므로 모든 origin에 읽기를 허용한다 (쿠키는 보내지 않는다)
	handle /media/* {
		header Access-Control-Allow-Origin *
		reverse_proxy 127.0.0.1:8180
	}

	# 데스크톱 앱 다운로드 페이지 (deploy/download/)
	redir /download /download/ permanent
	handle_path /download/* {
		# 패키지 파일은 GitHub Releases에 있다. 도메인 주소로 받을 수 있게 최신 릴리스로 넘긴다
		@package path /WebBroadcast-*
		redir @package https://github.com/wiwi-git/web-broadcast-proj/releases/latest/download{path} temporary

		root * /var/www/live-download
		file_server
	}

	# HLS 시청: /hls 접두사를 떼고 MediaMTX로, 리다이렉트 주소에는 다시 붙인다
	handle_path /hls/* {
		reverse_proxy 127.0.0.1:8888 {
			header_down Location ^/ /hls/
		}
	}

	# WHIP 송출: /whip 접두사를 떼고 MediaMTX로
	handle_path /whip/* {
		reverse_proxy 127.0.0.1:8889
	}

	# 나머지는 React 앱 (새로고침해도 index.html)
	handle {
		root * /var/www/live.duse.dev
		try_files {path} /index.html
		file_server
	}
}

# 새 서비스는 위처럼 블록을 추가한다
