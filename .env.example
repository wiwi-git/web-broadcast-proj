# 휴대폰이 WebRTC로 접속할 PC의 LAN IP (macOS: ipconfig getifaddr en0)
LAN_IP=

# 유튜브 동시 송출 (ADR-0007). 비워 두면 동시 송출만 쓸 수 없다.
# MediaMTX 중계 스크립트와 서버가 나눠 쓰는 값 (openssl rand -hex 32). 서버를 IDE/Gradle로 띄우면 server/config/local.properties의 simulcast.relay-secret에도 같은 값을 넣는다
SIMULCAST_RELAY_SECRET=
# YouTube Key를 DB에 암호화할 키 (openssl rand -base64 32). compose --profile app으로 서버를 띄울 때만 쓴다
SIMULCAST_ENCRYPTION_KEY=
