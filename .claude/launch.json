{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && ./gradlew bootRun --console=plain"],
      "port": 8080
    },
    {
      "name": "app-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd app && dx serve --platform web --port 8090 --open false"],
      "port": 8090
    }
  ]
}
