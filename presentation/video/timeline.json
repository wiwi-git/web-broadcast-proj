 ],
 "subtitles": [
  {
   "start": 0.448,
   "end": 1.555,
   "text": "Web Broadcast는"
  },
  {
   "start": 1.555,
   "end": 4.15,
   "text": "휴대폰 카메라로 라이브 방송을 하고,"
  },
  {
   "start": 4.15,
   "end": 5.936,
   "text": "녹화한 동영상을 올리고,"
  },
  {
   "start": 5.936,
   "end": 8.84,
   "text": "누구나 시청할 수 있는 웹 방송 플랫폼입니다."
  },
  {
   "start": 9.268,
   "end": 13.768,
   "text": "오늘은 방송자와 시청자, 두 사용자의 시점으로 화면과 기능,"
  },
  {
   "start": 13.768,
   "end": 16.173,
   "text": "그리고 그 뒤에서 동작하는 API와"
  },
  {
   "start": 16.173,
   "end": 18.161,
   "text": "기술을 차례로 보여드리겠습니다."
  },
  {
   "start": 19.087,
   "end": 20.325,
   "text": "전체 구조입니다."
  },
  {
   "start": 20.756,
   "end": 22.625,
   "text": "웹은 React와 Vite로,"
  },
  {
   "start": 22.625,
   "end": 24.863,
   "text": "서버는 Spring Boot 4와 Java 25로"
  },
  {
   "start": 24.863,
   "end": 28.53,
   "text": "만들었고, 데이터는 PostgreSQL에 저장합니다."
  },
  {
   "start": 28.948,
   "end": 31.924,
   "text": "라이브 영상은 스프링이 직접 받지 않습니다."
  },
  {
   "start": 32.36,
   "end": 36.181,
   "text": "미디어 서버인 MediaMTX가 영상을 받아 시청용 스트림으로"
  },
  {
   "start": 36.181,
   "end": 40.122,
   "text": "바꾸고, 스프링은 송출 허가와 방송 상태만 관리합니다."
  },
  {
   "start": 40.546,
   "end": 44.844,
   "text": "업로드한 동영상은 서버 안에서 ffmpeg로 화질별 HLS로"
  },
  {
   "start": 44.844,
   "end": 46.63,
   "text": "변환하고, 후원 결제는"
  },
  {
   "start": 46.63,
   "end": 49.308,
   "text": "토스페이먼츠 테스트 모드로 연동했습니다."
  },
  {
   "start": 50.837,
   "end": 52.682,
   "text": "먼저 방송자 시점입니다."
  },
  {
   "start": 53.118,
   "end": 55.451,
   "text": "방송을 시작하려면 로그인해야 합니다."
  },
  {
   "start": 55.901,
   "end": 60.127,
   "text": "로그인 상태는 JWT 대신, 서버 세션으로 유지합니다."
  },
  {
   "start": 60.562,
   "end": 62.764,
   "text": "세션은 Spring Session JDBC로"
  },
  {
   "start": 62.764,
   "end": 64.288,
   "text": "데이터베이스에 저장해서"
  },
  {
   "start": 64.288,
   "end": 67.121,
   "text": "서버를 재시작해도 로그인이 풀리지 않고,"
  },
  {
   "start": 67.121,
   "end": 69.097,
   "text": "로그아웃도 즉시 반영됩니다."
  },
  {
   "start": 69.515,
   "end": 73.063,
   "text": "쿠키를 쓰는 만큼, 웹에서 상태를 바꾸는 요청에는"
  },
  {
   "start": 73.063,
   "end": 76.17,
   "text": "CSRF 토큰을 헤더로 함께 보내도록 했습니다."
  },
  {
   "start": 77.1,
   "end": 79.385,
   "text": "제목을 적고 방송 시작을 누르면,"
  },
  {
   "start": 79.385,
   "end": 83.397,
   "text": "서버는 준비 상태의 방송을 만들고 방송 키를 발급합니다."
  },
  {
   "start": 83.813,
   "end": 87.372,
   "text": "한 사람이 동시에 진행할 수 있는 방송은 하나뿐이라,"
  },
  {
   "start": 87.372,
   "end": 89.837,
   "text": "이미 진행 중인 방송이 있으면 409와"
  },
  {
   "start": 89.837,
   "end": 92.456,
   "text": "함께 그 방송의 아이디를 돌려줍니다."
  },
  {
   "start": 92.881,
   "end": 94.488,
   "text": "방송 키는 SecureRandom으로"
  },
  {
   "start": 94.488,
   "end": 96.465,
   "text": "만든 32바이트 값입니다."
  },
  {
   "start": 96.904,
   "end": 99.083,
   "text": "발급할 때만 원문을 돌려주고,"
  },
  {
   "start": 99.083,
   "end": 101.393,
   "text": "데이터베이스에는 해시만 저장합니다."
  },
  {
   "start": 102.328,
   "end": 105.852,
   "text": "방송 화면에서는 브라우저가 카메라와 마이크를 열고,"
  },
  {
   "start": 105.852,
   "end": 107.971,
   "text": "WebRTC 표준 송출 방식인 WHIP으로"
  },
  {
   "start": 107.971,
   "end": 110.162,
   "text": "미디어 서버에 영상을 보냅니다."
  },
  {
   "start": 110.589,
   "end": 113.41,
   "text": "이 프로젝트는 WHIP 영상 송출"
  },
  {
   "start": 113.41,
   "end": 115.815,
   "text": "코덱을 H.264로 고정했습니다."
  },
  {
   "start": 116.245,
   "end": 118.864,
   "text": "방송 생성에는 로그인 세션을 쓰고,"
  },
  {
   "start": 118.864,
   "end": 121.876,
   "text": "미디어 서버의 송출 허가에는 방송 키를 씁니다."
  },
  {
   "start": 122.311,
   "end": 125.026,
   "text": "미디어 서버가 인증 훅으로 스프링에 묻고,"
  },
  {
   "start": 125.026,
   "end": 128.335,
   "text": "스프링이 키의 해시를 비교해서 허가 여부를 답합니다."
  },
  {
   "start": 129.257,
   "end": 133.352,
   "text": "방송 상태는 스프링이 2초 간격으로 미디어 서버에 실제 송출"
  },
  {
   "start": 133.352,
   "end": 137.757,
   "text": "현황을 묻고, 조회에 성공하면 그 결과를 DB에 반영합니다."
  },
  {
   "start": 138.183,
   "end": 140.993,
   "text": "이벤트 훅 대신 주기적 조회를 고른 이유는,"
  },
  {
   "start": 140.993,
   "end": 143.005,
   "text": "어느 한쪽이 재시작되어 이벤트를"
  },
  {
   "start": 143.005,
   "end": 145.302,
   "text": "놓쳐도 다음 조회에서 DB의 방송"
  },
  {
   "start": 145.302,
   "end": 147.576,
   "text": "상태가 저절로 맞춰지기 때문입니다."
  },
  {
   "start": 147.997,
   "end": 150.414,
   "text": "동기화 도중 소유자가 방송을 종료하면"
  },
  {
   "start": 150.414,
   "end": 153.128,
   "text": "낙관적 락으로 충돌을 감지해 다음 주기로"
  },
  {
   "start": 153.128,
   "end": 155.842,
   "text": "넘기고, 이미 종료된 방송으로 송출이"
  },
  {
   "start": 155.842,
   "end": 158.485,
   "text": "계속 들어오면 서버가 연결을 끊습니다."
  },
  {
   "start": 159.411,
   "end": 163.245,
   "text": "방송자는 라이브뿐 아니라 녹화한 동영상도 올릴 수 있습니다."
  },
  {
   "start": 163.674,
   "end": 165.888,
   "text": "이때는 콘텐츠의 소유자가 됩니다."
  },
  {
   "start": 166.323,
   "end": 169.097,
   "text": "업로드가 끝나면 동영상은 처리 중 상태가"
  },
  {
   "start": 169.097,
   "end": 170.93,
   "text": "되고, 서버 안의 단일 스레드"
  },
  {
   "start": 170.93,
   "end": 173.263,
   "text": "대기열이 ffmpeg로 원본 해상도에"
  },
  {
   "start": 173.263,
   "end": 176.061,
   "text": "맞는 화질의 HLS를 한 번에 만듭니다."
  },
  {
   "start": 176.486,
   "end": 180.165,
   "text": "1080p 원본이라면 1080p, 720p,"
  },
  {
   "start": 180.165,
   "end": 183.772,
   "text": "480p 세 가지이고, 썸네일은 따로 추출합니다."
  },
  {
   "start": 184.203,
   "end": 188.084,
   "text": "변환이 끝나면 공개 상태가 되어 바로 재생할 수 있습니다."
  },
  {
   "start": 188.517,
   "end": 190.529,
   "text": "지금 규모에서는 메시지 큐가"
  },
  {
   "start": 190.529,
   "end": 192.838,
   "text": "과하다고 판단해 서버 안에 두었고,"
  },
  {
   "start": 192.838,
   "end": 195.505,
   "text": "변환 로직은 인터페이스 뒤에 두어 나중에"
  },
  {
   "start": 195.505,
   "end": 197.874,
   "text": "별도 워커로 분리할 수 있게 했습니다."
  },
  {
   "start": 198.298,
   "end": 201.144,
   "text": "서버가 변환 도중 꺼지면, 다시 켜질 때"
  },
  {
   "start": 201.144,
   "end": 203.941,
   "text": "처리 중이던 동영상을 대기열에 다시 넣습니다."
  },
  {
   "start": 205.483,
   "end": 207.233,
   "text": "이제 시청자 시점입니다."
  },
  {
   "start": 207.682,
   "end": 210.42,
   "text": "시청은 로그인 없이 누구나 할 수 있습니다."
  },
  {
   "start": 210.851,
   "end": 214.41,
   "text": "라이브 목록은 방송 중인 방송과 최근 종료된 방송을"
  },
  {
   "start": 214.41,
   "end": 218.136,
   "text": "나눠서 보여주고, 준비 상태의 방송은 보이지 않습니다."
  },
  {
   "start": 218.555,
   "end": 221.139,
   "text": "방송을 누르면 미디어 서버가 만든 저지연"
  },
  {
   "start": 221.139,
   "end": 224.472,
   "text": "HLS를 hls.js로 재생합니다."
  },
  {
   "start": 224.9,
   "end": 228.329,
   "text": "미디어 서버는 종료된 방송의 시청 요청을 인증 훅에서"
  },
  {
   "start": 228.329,
   "end": 231.877,
   "text": "거부하고, 웹은 방송 중일 때만 플레이어를 엽니다."
  },
  {
   "start": 232.803,
   "end": 235.196,
   "text": "동영상 목록에는 변환이 끝난 공개"
  },
  {
   "start": 235.196,
   "end": 237.672,
   "text": "상태의 동영상만 최신순으로 나옵니다."
  },
  {
   "start": 238.108,
   "end": 240.322,
   "text": "재생은 네트워크 상황에 따라 화질이"
  },
  {
   "start": 240.322,
   "end": 243.203,
   "text": "자동으로 바뀌는 적응형 HLS이고,"
  },
  {
   "start": 243.203,
   "end": 246.251,
   "text": "시청자가 원하는 화질을 직접 고를 수도 있습니다."
  },
  {
   "start": 247.174,
   "end": 249.888,
   "text": "로그인한 회원은 댓글을 남길 수 있고,"
  },
  {
   "start": 249.888,
   "end": 253.019,
   "text": "댓글은 작성자만 수정하거나 삭제할 수 있습니다."
  },
  {
   "start": 253.451,
   "end": 255.737,
   "text": "콘텐츠의 소유자라도 남의 댓글을"
  },
  {
   "start": 255.737,
   "end": 258.13,
   "text": "직접 수정하거나 지울 수는 없습니다."
  },
  {
   "start": 258.562,
   "end": 261.336,
   "text": "버튼을 숨기는 건 화면의 편의일 뿐이고,"
  },
  {
   "start": 261.336,
   "end": 263.467,
   "text": "모든 권한은 서버가 검사합니다."
  },
  {
   "start": 263.897,
   "end": 266.242,
   "text": "동영상 댓글의 더 보기는 마지막으로"
  },
  {
   "start": 266.242,
   "end": 268.421,
   "text": "본 댓글보다 오래된 댓글을 불러오는"
  },
  {
   "start": 268.421,
   "end": 270.778,
   "text": "커서 방식이라, 새 댓글이 달려도"
  },
  {
   "start": 270.778,
   "end": 273.147,
   "text": "기존 페이지 경계가 밀리지 않습니다."
  },
  {
   "start": 274.076,
   "end": 277.493,
   "text": "시청자는 방송 중인 방송자에게 후원할 수 있습니다."
  },
  {
   "start": 277.937,
   "end": 281.234,
   "text": "금액은 1,000원부터 50만 원까지 1,000원 단위이고,"
  },
  {
   "start": 281.234,
   "end": 283.401,
   "text": "자기 방송에는 후원할 수 없습니다."
  },
  {
   "start": 283.826,
   "end": 285.35,
   "text": "후원하기를 누르면 서버가"
  },
  {
   "start": 285.35,
   "end": 288.171,
   "text": "먼저 결제 대기 상태의 후원을 만들고,"
  },
  {
   "start": 288.171,
   "end": 291.648,
   "text": "그 아이디를 주문번호로 토스페이먼츠 결제창을 엽니다."
  },
  {
   "start": 292.573,
   "end": 296.002,
   "text": "결제 인증을 마치고 돌아오면, 서버는 결제 금액이"
  },
  {
   "start": 296.002,
   "end": 299.264,
   "text": "처음 저장한 후원 금액과 같은지 먼저 확인합니다."
  },
  {
   "start": 299.696,
   "end": 303.184,
   "text": "승인을 요청하기 전에 금액이 다르면 실패로 끝내고,"
  },
  {
   "start": 303.184,
   "end": 307.112,
   "text": "이미 승인을 요청한 뒤라면 거절만 하고 결제 대기로 둡니다."
  },
  {
   "start": 307.536,
   "end": 311.167,
   "text": "금액이 맞으면 토스페이먼츠 승인 API를 부르는데,"
  },
  {
   "start": 311.167,
   "end": 314.167,
   "text": "이때 주문번호로 만든 멱등키를 함께 보냅니다."
  },
  {
   "start": 314.591,
   "end": 318.603,
   "text": "타임아웃으로 결과를 받지 못하면 결제 대기로 남겨 두고,"
  },
  {
   "start": 318.603,
   "end": 320.913,
   "text": "같은 승인 요청을 다시 보내면 같은"
  },
  {
   "start": 320.913,
   "end": 323.663,
   "text": "멱등키를 써서 승인이 중복되지 않습니다."
  },
  {
   "start": 324.085,
   "end": 326.466,
   "text": "30분이 지난 결제 대기는 1분마다"
  },
  {
   "start": 326.466,
   "end": 328.68,
   "text": "도는 정리 작업이 처리합니다."
  },
  {
   "start": 329.103,
   "end": 332.722,
   "text": "승인을 요청하기 전이면 만료시키고, 승인을 요청했다면"
  },
  {
   "start": 332.722,
   "end": 336.21,
   "text": "주문번호로 토스페이먼츠에 조회해서 결과를 맞춥니다."
  },
  {
   "start": 337.131,
   "end": 339.667,
   "text": "여기서는 완료 처리한 샘플 후원으로,"
  },
  {
   "start": 339.667,
   "end": 343.869,
   "text": "시청자 화면의 후원 기록과 방송자 화면의 알림을 보여드립니다."
  },
  {
   "start": 344.282,
   "end": 346.008,
   "text": "방송 중에는 완료된 후원을"
  },
  {
   "start": 346.008,
   "end": 348.52,
   "text": "3초 주기로 조회해서 알림을 띄웁니다."
  },
  {
   "start": 348.953,
   "end": 352.822,
   "text": "공개되는 건 완료된 후원뿐이고, 실패하거나 취소된 후원은"
  },
  {
   "start": 352.822,
   "end": 355.488,
   "text": "후원자 본인만 후원 내역에서 볼 수 있습니다."
  },
  {
   "start": 356.82,
   "end": 359.487,
   "text": "정리하면, 이 프로젝트에서 가장 신경"
  },
  {
   "start": 359.487,
   "end": 361.879,
   "text": "쓴 부분은 책임을 나누는 일이었습니다."
  },
  {
   "start": 362.326,
   "end": 365.267,
   "text": "미디어는 미디어 서버에 맡기고, 스프링은"
  },
  {
   "start": 365.267,
   "end": 368.517,
   "text": "권한과 상태라는 비즈니스 규칙에 집중했습니다."
  },
  {
   "start": 368.944,
   "end": 371.396,
   "text": "그리고 실패를 전제로 설계했습니다."
  },
  {
   "start": 371.836,
   "end": 374.669,
   "text": "이벤트를 놓쳐도 맞춰지는 상태 동기화,"
  },
  {
   "start": 374.669,
   "end": 376.74,
   "text": "결과를 받지 못해도 다시 맞출 수"
  },
  {
   "start": 376.74,
   "end": 378.716,
   "text": "있는 결제 승인이 그 예입니다."
  },
  {
   "start": 379.148,
   "end": 381.743,
   "text": "권한과 결제 흐름은 Testcontainers로"
  },
  {
   "start": 381.743,
   "end": 384.624,
   "text": "실제 PostgreSQL을 띄워 HTTP 요청"
  },
  {
   "start": 384.624,
   "end": 388.755,
   "text": "단위로 검증했고, 결제는 가짜 결제 서비스로 승인,"
  },
  {
   "start": 388.755,
   "end": 391.588,
   "text": "거절, 결과 모름을 모두 확인했습니다."
  },
  {
   "start": 392.021,
   "end": 394.306,
   "text": "지금까지 Web Broadcast였습니다."
  },
  {
   "start": 394.728,
   "end": 395.847,
   "text": "감사합니다."
  }
 ]
}