# 이 파일을 config/local.properties로 복사해 본인 키를 적는다. config/local.properties는 git에 올라가지 않는다.
# 토스페이먼츠 개발자센터 > API 키 > API 개별 연동 키의 테스트 키 한 쌍 (사업자 등록 없이 가입만 하면 받을 수 있다)
# 같은 쌍의 클라이언트 키와 시크릿 키를 넣어야 한다. 테스트 키(test_ck_, test_sk_로 시작)만 받는다.
toss.client-key=test_ck_
toss.secret-key=test_sk_

# 메일: 로컬 Mailpit(docker compose up -d mailpit)으로 보내고 http://localhost:8025에서 받은 메일을 본다.
# 비워 두면 메일 대신 서버 로그에 인증·재설정 링크가 찍힌다
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
